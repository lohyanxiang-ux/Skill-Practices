        "step3": "scope.gcd > 1 ? '\\\\frac{' + scope.unsimpFinalNum + '}{' + scope.comDen + '} = ' + scope.simpStep : '\\\\frac{' + scope.unsimpFinalNum + '}{' + scope.comDen + '}'"
      },
      "questionTemplate": "Simplify the expression:\n\n$$${scope.expr}$$",
      "inputs": [
        { "label": "=", "answer": "${scope.ans}" }
      ],
      "steps": [
        "Find the common denominator (LCM) and rewrite each numerator: $$${scope.step1}$$",
        "Expand terms taking care of subtraction signs: $$${scope.step2}$$",
        "Combine like terms in the numerator and simplify: $$${scope.step3}$$"
      ]
    }
  ]
}
