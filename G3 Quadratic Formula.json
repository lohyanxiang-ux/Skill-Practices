{
  "skillTitle": "Solve Quadratic Equations using Quadratic Formula",
  "keypad": [
  "x", "=", "or", "/",
  "7", "8", "9", "+",
  "4", "5", "6", "-",
  "1", "2", "3", "0",
  ".", "(", "⌫", "Clear"
],
  "structures": [
    {
      "level": 1,
      "variables": {
        "a": { "type": "randInt", "min": 1, "max": 6 },
        "b": { "type": "randInt", "min": -9, "max": 9, "excludeZero": true },
        "c": { "type": "randInt", "min": -9, "max": -1 }
      },
      "derived": {
        "a_quad": "scope.a",
        "b_quad": "scope.b",
        "c_quad": "scope.c",
        "a_str": "scope.a === 1 ? 'x^2' : scope.a + 'x^2'",
        "b_str": "scope.b === 1 ? ' + x' : (scope.b === -1 ? ' - x' : (scope.b > 0 ? ' + ' + scope.b + 'x' : ' - ' + Math.abs(scope.b) + 'x'))",
        "c_str": "scope.c > 0 ? ' + ' + scope.c : ' - ' + Math.abs(scope.c)",
        "eq": "scope.a_str + scope.b_str + scope.c_str + ' = 0'",
        "disc": "scope.b_quad * scope.b_quad - 4 * scope.a_quad * scope.c_quad",
        "x1_val": "(-scope.b_quad + Math.sqrt(scope.disc)) / (2 * scope.a_quad)",
        "x2_val": "(-scope.b_quad - Math.sqrt(scope.disc)) / (2 * scope.a_quad)",
        "ans1": "Math.min(parseFloat(scope.x1_val.toPrecision(3)), parseFloat(scope.x2_val.toPrecision(3))).toString()",
        "ans2": "Math.max(parseFloat(scope.x1_val.toPrecision(3)), parseFloat(scope.x2_val.toPrecision(3))).toString()",
        "step1": "'a = ' + scope.a_quad + ', \\\\ b = ' + scope.b_quad + ', \\\\ c = ' + scope.c_quad",
        "step2": "'x = \\\\frac{-(' + (scope.b_quad < 0 ? '(' + scope.b_quad + ')' : scope.b_quad) + ') \\\\pm \\\\sqrt{(' + scope.b_quad + ')^2 - 4(' + scope.a_quad + ')(' + (scope.c_quad < 0 ? '(' + scope.c_quad + ')' : scope.c_quad) + ')}}{2(' + scope.a_quad + ')}'",
        "step3": "'x = ' + scope.ans1 + ' \\\\text{ or } x = ' + scope.ans2"
      },
      "questionTemplate": "Solve the following equation using the quadratic formula. Give your answers correct to 3 significant figures.\n\n$$${scope.eq}$$",
      "inputs": [
        { "label": "x =", "answer": "${scope.ans1}" },
        { "label": "or  x =", "answer": "${scope.ans2}" }
      ],
      "steps": [
        "Identify the coefficients $a$, $b$, and $c$ from $ax^2 + bx + c = 0$: $$${scope.step1}$$",
        "Substitute $a$, $b$, and $c$ into the quadratic formula $x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}$: $$${scope.step2}$$",
        "Evaluate using a calculator (rounding to 3 significant figures): $$${scope.step3}$$"
      ]
    },
    {
      "level": 1,
      "variables": {
        "a": { "type": "randInt", "min": 2, "max": 5 },
        "b_raw": { "type": "randInt", "min": 6, "max": 10 },
        "c": { "type": "randInt", "min": 1, "max": 3 }
      },
      "derived": {
        "b_eff": "scope.b_raw * scope.b_raw <= 4 * scope.a * scope.c ? Math.ceil(Math.sqrt(4 * scope.a * scope.c)) + 3 : scope.b_raw",
        "a_quad": "scope.a",
        "b_quad": "scope.b_eff",
        "c_quad": "scope.c",
        "a_str": "scope.a + 'x^2'",
