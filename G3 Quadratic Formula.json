        "n": { "type": "randInt", "min": 1, "max": 4 },
        "p": { "type": "randInt", "min": 2, "max": 5 },
        "q": { "type": "randInt", "min": 10, "max": 30 }
      },
      "derived": {
        "a_quad": "scope.m",
        "b_quad": "scope.p - 1 - scope.m * scope.n",
