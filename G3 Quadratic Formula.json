        "ans1": "Math.min(parseFloat(scope.x1_val.toPrecision(3)), parseFloat(scope.x2_val.toPrecision(3))).toString()",
        "ans2": "Math.max(parseFloat(scope.x1_val.toPrecision(3)), parseFloat(scope.x2_val.toPrecision(3))).toString()",
        "step1": "scope.std_eq",
        "step2": "'a = ' + scope.a_quad + ', \\\\ b = ' + scope.b_quad + ', \\\\ c = ' + scope.c_quad",
        "step3": "'x = \\\\frac{-(' + (scope.b_quad < 0 ? '(' + scope.b_quad + ')' : scope.b_quad) + ') \\\\pm \\\\sqrt{(' + scope.b_quad + ')^2 - 4(' + scope.a_quad + ')(' + (scope.c_quad < 0 ? '(' + scope.c_quad + ')' : scope.c_quad) + ')}}{2(' + scope.a_quad + ')}'",
        "step4": "'x = ' + scope.ans1 + ' \\\\text{ or } x = ' + scope.ans2"
      },
      "questionTemplate": "Solve the following equation using the quadratic formula. Give your answers correct to 3 significant figures.\n\n$$${scope.eq}$$",
      "inputs": [
        { "label": "x =", "answer": "${scope.ans1}" },
        { "label": "or  x =", "answer": "${scope.ans2}" }
      ],
      "steps": [
        "Expand using a multiplication frame and rearrange to standard form $ax^2 + bx + c = 0$: $$${scope.step1}$$",
        "Identify $a$, $b$, and $c$: $$${scope.step2}$$",
        "Substitute values into the quadratic formula: $$${scope.step3}$$",
        "Evaluate using a calculator (rounding to 3 significant figures): $$${scope.step4}$$"
      ]
    },
    {
      "level": 3,
      "variables": {
