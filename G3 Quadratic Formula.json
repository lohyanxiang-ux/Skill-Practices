        "eq": "'x + ' + scope.m + 'x(' + scope.n + ' - x) = ' + scope.p + 'x - ' + scope.q",
        "b_str": "scope.b_quad === 0 ? '' : (scope.b_quad === 1 ? ' + x' : (scope.b_quad === -1 ? ' - x' : (scope.b_quad > 0 ? ' + ' + scope.b_quad + 'x' : ' - ' + Math.abs(scope.b_quad) + 'x')))",
