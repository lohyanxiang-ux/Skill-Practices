        "step4": "'x = ' + scope.ans1 + ' \\\\text{ or } x = ' + scope.ans2"
      },
      "questionTemplate": "Solve the following equation using the quadratic formula. Give your answers correct to 3 significant figures.\n\n$$${scope.eq}$$",
      "inputs": [
