        "ans2": "Math.max(parseFloat(scope.x1_val.toPrecision(3)), parseFloat(scope.x2_val.toPrecision(3))).toString()",
        "step1": "'a = ' + scope.a_quad + ', \\\\ b = ' + scope.b_quad + ', \\\\ c = ' + scope.c_quad",
        "step2": "'x = \\\\frac{-(' + scope.b_quad + ') \\\\pm \\\\sqrt{(' + scope.b_quad + ')^2 - 4(' + scope.a_quad + ')(' + scope.c_quad + ')}}{2(' + scope.a_quad + ')}'",
        "step3": "'x = ' + scope.ans1 + ' \\\\text{ or } x = ' + scope.ans2"
      },
      "questionTemplate": "Solve the following equation using the quadratic formula. Give your answers correct to 3 significant figures.\n\n$$${scope.eq}$$",
      "inputs": [
        { "label": "x =", "answer": "${scope.ans1}" },
        { "label": "or  x =", "answer": "${scope.ans2}" }
      ],
      "steps": [
        "Identify the coefficients $a$, $b$, and $c$: $$${scope.step1}$$",
        "Substitute into the quadratic formula $x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}$: $$${scope.step2}$$",
        "Evaluate using a calculator to find the roots rounded to 3 significant figures: $$${scope.step3}$$"
      ]
    },
    {
      "level": 2,
      "variables": {
        "a": { "type": "randInt", "min": 2, "max": 5 },
        "b": { "type": "randInt", "min": -6, "max": 6, "excludeZero": true },
        "c": { "type": "randInt", "min": 3, "max": 12 }
      },
      "derived": {
