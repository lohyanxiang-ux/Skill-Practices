        "num_sim": "scope.num_raw / scope.g",
        "den_sim": "scope.den_raw / scope.g",
        "num_str_input": "scope.num_sim === 1 ? 'x' : scope.num_sim + 'x'",
        "ans": "scope.den_sim === 1 ? scope.num_str_input : scope.num_str_input + '/' + scope.den_sim",
        "num_str_latex": "scope.num_sim === 1 ? 'x' : scope.num_sim + 'x'",
