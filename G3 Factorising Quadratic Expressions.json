        "table": "'$$\\\\begin{array}{c|c|r} x & ' + scope.p_str + ' & ' + scope.px_str + ' \\\\\\\\ x & ' + scope.q_str + ' & ' + scope.qx_str + ' \\\\\\\\ \\\\hline x^2 & ' + scope.prod_str + ' & ' + scope.sumX_str + ' \\\\end{array}$$'"
      },
