        "step1": "scope.g > 1 ? ('Factorise out the common factor ' + scope.g + ' from all terms:\\n\\n$$' + scope.g + '(' + scope.innerExpr + ')$$') : 'Check for common factors among the terms (there are none).'",
        "step2": "scope.g > 1 ? ('Rewrite the expression inside the brackets in the form $$(a)^2 - (b)^2$$:\\n\\n$$' + scope.g + '(' + scope.formSqInner + ')$$') : ('Rewrite the expression in the form $$(a)^2 - (b)^2$$:\\n\\n$$' + scope.formSq + '$$')",
        "step3": "'Apply the difference of squares formula $$a^2 - b^2 = (a - b)(a + b)$$ to write down the final answer:\\n\\n$$' + scope.ans + '$$'"
      },
      "questionTemplate": "Factorise the expression completely:\n\n$$${scope.expr}$$",
