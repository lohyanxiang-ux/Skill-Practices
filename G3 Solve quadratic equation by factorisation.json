        "step3": "'x ' + (-scope.r1 > 0 ? '+ ' + -scope.r1 : '- ' + Math.abs(scope.r1)) + ' = 0 \\\\text{ or } x ' + (-scope.r2 > 0 ? '+ ' + -scope.r2 : '- ' + Math.abs(scope.r2)) + ' = 0'",
        "step4": "'x = ' + scope.r1 + ' \\\\text{ or } x = ' + scope.r2",
        "ans1": "scope.r1.toString()",
        "ans2": "scope.r2.toString()"
      },
      "questionTemplate": "Solve the equation by factorisation:\n\n$x(${scope.eqLHS}) = ${scope.eqRHS}$",
      "inputs": [
        { "label": "$x_1 =$", "answer": "${scope.ans1}" },
        { "label": "$x_2 =$", "answer": "${scope.ans2}" }
      ],
