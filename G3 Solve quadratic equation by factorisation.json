    {
      "level": 1,
      "variables": {
        "a": { "type": "randInt", "min": 1, "max": 3 },
        "b": { "type": "randInt", "min": -6, "max": 6, "excludeZero": true },
        "c": { "type": "randInt", "min": 1, "max": 2 },
        "d": { "type": "randInt", "min": -6, "max": 6, "excludeZero": true }
      },
      "derived": {
        "d_eff": "((Math.abs(scope.a * scope.d + scope.b * scope.c) % 10 === 0) || (scope.b === scope.d)) ? (scope.d === 6 ? -5 : scope.d + 1) : scope.d",
        "coeffA": "scope.a * scope.c",
