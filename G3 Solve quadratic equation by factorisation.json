        { "label": "or  x =", "answer": "${scope.ans2}" }
      ],
      "steps": [
        "Set each factor equal to zero:\n\n$$${scope.factor1} = 0 \\quad \\text{or} \\quad ${scope.factor2} = 0$$",
        "Solve for $x$ in each linear equation:\n\n$$x = ${scope.ans1_tex} \\quad \\text{or} \\quad x = ${scope.ans2_tex}$$"
