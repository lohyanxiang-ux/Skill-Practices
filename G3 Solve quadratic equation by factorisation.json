        "c": { "type": "randInt", "min": 1, "max": 3 },
        "d": { "type": "randInt", "min": -7, "max": 7, "excludeZero": true }
      },
      "derived": {
        "d_eff": "(scope.b === scope.d) ? (scope.d === 7 ? -6 : scope.d + 1) : scope.d",
        "factor1": "(scope.a === 1 ? 'x' : scope.a + 'x') + (scope.b > 0 ? ' + ' + scope.b : ' - ' + Math.abs(scope.b))",
        "factor2": "(scope.c === 1 ? 'x' : scope.c + 'x') + (scope.d_eff > 0 ? ' + ' + scope.d_eff : ' - ' + Math.abs(scope.d_eff))",
        "n1": "-scope.b",
        "d1": "scope.a",
        "g1": "(function(u,v){ u=Math.abs(u); v=Math.abs(v); while(v){ var t=v; v=u%v; u=t; } return u; })(scope.n1, scope.d1)",
        "num1": "scope.n1 / scope.g1",
        "den1": "scope.d1 / scope.g1",
        "ans1": "scope.den1 === 1 ? scope.num1.toString() : scope.num1 + '/' + scope.den1",
        "ans1_tex": "scope.den1 === 1 ? scope.num1.toString() : '\\\\frac{' + scope.num1 + '}{' + scope.den1 + '}'",
        "n2": "-scope.d_eff",
        "d2": "scope.c",
        "g2": "(function(u,v){ u=Math.abs(u); v=Math.abs(v); while(v){ var t=v; v=u%v; u=t; } return u; })(scope.n2, scope.d2)",
