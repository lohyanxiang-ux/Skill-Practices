{
  "skillTitle": "Solving Quadratic Equations using Factorisation",
  "keypad": [
    "7", "8", "9", "/",
    "4", "5", "6", "-",
    "1", "2", "3", ".",
    "0", "x", "⌫", "Clear"
  ],
  "structures": [
    {
      "level": 1,
