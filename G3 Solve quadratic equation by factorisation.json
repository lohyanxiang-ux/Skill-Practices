        "simplified_f2": "scope.LHS_f2",
        "ans1": "(-scope.c).toString()",
        "ans1_tex": "(-scope.c).toString()",
        "n2": "scope.e - scope.b_eff",
        "d2": "scope.a - scope.d",
        "g2": "(function(u,v){ u=Math.abs(u); v=Math.abs(v); while(v){ var t=v; v=u%v; u=t; } return u; })(scope.n2, scope.d2)",
        "num2": "scope.n2 / scope.g2",
        "den2": "scope.d2 / scope.g2",
        "ans2": "scope.den2 === 1 ? scope.num2.toString() : scope.num2 + '/' + scope.den2",
        "ans2_tex": "scope.den2 === 1 ? scope.num2.toString() : '\\\\frac{' + scope.num2 + '}{' + scope.den2 + '}'"
      },
      "questionTemplate": "Solve the equation:\n\n$$${scope.LHS} = ${scope.RHS}$$",
      "inputs": [
        { "label": "x =", "answer": "${scope.ans1}" },
        { "label": "or  x =", "answer": "${scope.ans2}" }
      ],
      "steps": [
        "Rearrange all terms to one side of the equation:\n\n$$(${scope.LHS_f1})(${scope.LHS_f2}) - (${scope.RHS_f1})(${scope.RHS_f2}) = 0$$",
        "Factorise out the common factor $(${scope.LHS_f2})$:\n\n$$(${scope.LHS_f2})[(${scope.LHS_f1}) - (${scope.RHS_f1})] = 0$$",
        "Simplify the second factor:\n\n$$(${scope.simplified_f2})(${scope.simplified_f1}) = 0$$",
        "Set each factor equal to zero and solve for $x$:\n\n$$x = ${scope.ans1_tex} \\quad \\text{or} \\quad x = ${scope.ans2_tex}$$"
      ]
    },
    {
      "level": 3,
      "variables": {
        "a": { "type": "randInt", "min": -6, "max": 6, "excludeZero": true },
        "b": { "type": "randInt", "min": 2, "max": 9 }
      },
      "derived": {
        "r1": "-scope.a",
        "r2": "scope.b - scope.a",
        "ans1": "scope.r1.toString()",
        "ans2": "scope.r2.toString()",
        "xa": "'x ' + (scope.a > 0 ? '+ ' + scope.a : '- ' + Math.abs(scope.a))",
        "x_ab": "'x ' + (scope.a - scope.b > 0 ? '+ ' + (scope.a - scope.b) : '- ' + Math.abs(scope.a - scope.b))",
        "step1": "'(' + scope.xa + ')^2 - ' + scope.b + '(' + scope.xa + ') = 0'",
        "step2": "'(' + scope.xa + ')(' + scope.x_ab + ') = 0'",
        "step3": "scope.xa + ' = 0 \\\\text{ or } ' + scope.x_ab + ' = 0'",
        "step4": "'x = ' + scope.r1 + ' \\\\text{ or } x = ' + scope.r2"
      },
      "questionTemplate": "Solve the equation by factorisation:\n\n$(${scope.xa})^2 = ${scope.b}(${scope.xa})$",
      "inputs": [
        { "label": "$x_1 =$", "answer": "${scope.ans1}" },
        { "label": "$x_2 =$", "answer": "${scope.ans2}" }
      ],
      "steps": [
        "Rearrange equation to set equal to zero: $${scope.step1}$",
        "Factorise out common factor $(${scope.xa})$: $${scope.step2}$",
        "Set each factor to zero: $${scope.step3}$",
        "Solve for $x$: $${scope.step4}$"
      ]
    }
  ]
}