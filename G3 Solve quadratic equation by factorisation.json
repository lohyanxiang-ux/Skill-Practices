        "step3": "scope.a + 'x ' + (-scope.b > 0 ? '+ ' + -scope.b : '- ' + Math.abs(scope.b)) + ' = 0 \\\\text{ or } ' + scope.pxq + ' = 0'",
        "step4": "'x = ' + scope.f1_latex + ' \\\\text{ or } x = ' + scope.f2_latex"
